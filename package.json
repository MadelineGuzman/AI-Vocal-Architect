{
  "name": "cadenzai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "relay": "tsx relay/start.ts",
    "build": "tsc && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "node tests/release-smoke.mjs && node tests/melody-analysis.mjs && node tests/owner-auth.mjs && tsx tests/project-workflow.ts && npm run test:reaper && npm run test:levels && tsx tests/relay.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:reaper": "tsx tests/reaper-bridge.ts && tsx tests/reaper-request.ts && tsx tests/describe-effect.ts && tsx tests/describe-automation.ts && tsx tests/proposals.ts && tsx tests/vocal-chain.ts",
    "test:levels": "tsx tests/reaper-levels.ts"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "wavesurfer.js": "^7.12.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
